          "CL2": "FFFFFFFF",
          "CH1": "// IMPORTANT: When implementing\r\n// long-running operations,\r\n// it is crucial to enable timely and\r\n// responsive cancellation. To achieve\r\n// this, ensure that your code\r\n// is designed to respond appropriately\r\n// to cancellation requests using\r\n// the context.CancellationToken\r\n// mechanism. For more detailed\r\n// information and examples,\r\n// please, refer to our documentation.\r\nGuid reportId = Get<Guid>(\"TriggerRecordId\");\r\n\r\nvar select = new Terrasoft.Core.DB.Select(UserConnection)\r\n    .Column(\"PgrName\")\r\n    .From(\"PgrWeeklySalesReport\")\r\n    .Where(\"Id\").IsEqual(Terrasoft.Core.DB.Column.Parameter(reportId)) as Terrasoft.Core.DB.Select;\r\n\r\nstring reportName = string.Empty;\r\nusing (var dbExecutor = UserConnection.EnsureDBConnection()) {\r\n    using (var reader = select.ExecuteReader(dbExecutor)) {\r\n        if (reader.Read()) {\r\n            reportName = reader.GetColumnValue<string>(\"PgrName\");\r\n        }\r\n    }\r\n}\r\n\r\nstring safeName = System.Text.RegularExpressions.Regex.Replace(reportName, @\"[^a-zA-Z0-9]+\", \"_\").Trim('_');\r\nstring timestamp = DateTime.Now.ToString(\"yyyyMMdd_HHmmss\");\r\nstring fileName = \"WeeklySalesReport_\" + safeName + \"_\" + timestamp + \".docx\";\r\n\r\nvar reportService = new Terrasoft.Configuration.ReportService.ReportService();\r\nTerrasoft.Configuration.ReportService.ReportData report =\r\n    reportService.GenerateMSWordReport(\"fac82928-2a73-5569-fe8b-baf7d7c23974\", reportId.ToString(), false);\r\n\r\nvar fileSchema = UserConnection.EntitySchemaManager.GetInstanceByName(\"SysFile\");\r\nvar fileEntity = fileSchema.CreateEntity(UserConnection);\r\nfileEntity.SetDefColumnValues();\r\nfileEntity.SetColumnValue(\"RecordId\", reportId);\r\nfileEntity.SetColumnValue(\"RecordSchemaName\", \"PgrWeeklySalesReport\");\r\nfileEntity.SetColumnValue(\"Name\", fileName);\r\nfileEntity.SetColumnValue(\"TypeId\", new Guid(\"529bc2f8-0ee0-df11-971b-001d60e938c6\"));\r\nfileEntity.SetColumnValue(\"Data\", report.Data);\r\nfileEntity.SetColumnValue(\"Size\", report.Data.Length);\r\nfileEntity.SetColumnValue(\"TotalSize\", report.Data.Length);\r\nfileEntity.SetColumnValue(\"SysFileStorage\", new Guid(\"65e42805-0e6d-43c9-8784-32b555f08421\"));\r\nfileEntity.Save();\r\n\r\nreturn true;",
